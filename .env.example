# --- Appium server ---
APPIUM_SERVER_URL=http://127.0.0.1:4723

# --- Device / Emulator ---
PLATFORM_NAME=Android
PLATFORM_VERSION=14
DEVICE_NAME=Android Emulator
# UDID=emulator-5554   # uncomment to target a specific device

# --- Application under test (SwagLabs demo app) ---
# Download: https://github.com/saucelabs/sample-app-mobile/releases
APP_PATH=apps/Android.SauceLabs.Mobile.Sample.app.apk
APP_PACKAGE=com.swaglabsmobileapp
APP_ACTIVITY=com.swaglabsmobileapp.MainActivity
NO_RESET=false
FULL_RESET=false

# --- SwagLabs test accounts ---
VALID_USERNAME=standard_user
VALID_PASSWORD=secret_sauce
LOCKED_USERNAME=locked_out_user

# --- Framework ---
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20
SCREENSHOT_ON_FAILURE=true
